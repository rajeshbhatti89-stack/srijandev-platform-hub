# =============================================================================
# SrijanDev Platform Hub - Production-Ready Security & Git Hygiene .gitignore
# =============================================================================

# --- Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build & Output Artifacts ---
.next/
out/
build/
dist/
.wrangler/
wrangler-dist/

# --- Environment & Secret Credentials ---
.env
.env*.local
.env.development
.env.test
.env.production
.env.staging
*.env
*.env.*
!.env.example

# --- Local Databases & Storage ---
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.sql.gz
*.d1
.local-storage/

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- Security Certificates & Keys ---
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.keystore
id_rsa
id_ecdsa
id_ed25519

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Developer Tooling ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Cloud & Deployment Caches ---
.vercel
.serverless/
.terraform/
.turbo/
